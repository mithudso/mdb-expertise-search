# MDBX_CONCEPTS_SRC relative overrides resolve from the repository root; its unset default is $HOME/.global-ai-hub/llms-concepts.
# MDBX_DB and MDBX_CORPUS are optional: unset paths use the package root; explicit relative paths use the current directory.
# MDBX_DB=./data/mdbx.sqlite
# MDBX_CORPUS=./corpus
MDBX_OLLAMA_HOST=http://127.0.0.1:11434
MDBX_EMBED_MODEL=nomic-embed-text
# mql-lsp: set to 0 to disable static optimizer diagnostics (opt/*)
# MDBX_LSP_OPTIMIZE=1
# scripts/sync_corpus.sh: source of the mongodb-*.llms fact families
# MDBX_CONCEPTS_SRC=$HOME/.global-ai-hub/llms-concepts

# These examples document exported environment variables; mdbx does not load this file automatically.
# MDBX_EMBED_BACKEND=auto
# MDBX_ONNX_MODEL=/absolute/path/to/an/offline-model-directory
# OLLAMA_HOST=http://127.0.0.1:11434
# MDBX_SKILLS_SRC=/absolute/path/to/local-skills
# MDBX_LLMS_SRC=/absolute/path/to/local-llms-exports
# MDBX_MONGODB_DOCS_LLMS=/absolute/path/to/public-docs-export
# MDBX_DENYLIST=/absolute/path/to/private-local-denylist
# MDBX_REDACTIONS=/absolute/path/to/private-local-redaction-config
# MDBX_AUTOUPDATE_CONFIG=/absolute/path/to/local-chrome-updater.json
# MDBX_CORPUS_AUTOUPDATE_CONFIG=/absolute/path/to/local-corpus-updater.json
# MDBX_SKIP_INDEX=1
# MDBX_UPDATER_HOLDBACK=0
