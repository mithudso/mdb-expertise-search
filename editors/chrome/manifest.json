{
  "manifest_version": 3,
  "name": "MQL Query Optimizer",
  "short_name": "MQL Optimizer",
  "version": "0.1.0",
  "description": "Highlight a MongoDB query, slow-query log line or pipeline, click, and get findings, safe rewrites and index advice. Runs locally.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Optimize the highlighted MQL (Alt+Shift+O)",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["activeTab", "scripting", "contextMenus", "storage"],
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+O" },
      "description": "Optimize the highlighted query"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
