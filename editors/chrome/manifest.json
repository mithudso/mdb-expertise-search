{
  "manifest_version": 3,
  "name": "MongoDB Expertise",
  "short_name": "MongoDB Expertise",
  "version": "0.2.0",
  "description": "Search MongoDB expertise, recipes and docs; optimize and lint highlighted queries or slow-query log lines. Runs locally.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Optimize the highlighted MQL or search MongoDB expertise (Alt+Shift+O)",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["activeTab", "scripting", "contextMenus", "storage"],
  "optional_host_permissions": ["http://127.0.0.1/*", "http://localhost/*"],
  "omnibox": { "keyword": "mdb" },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+O" },
      "description": "Optimize the highlighted query"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
